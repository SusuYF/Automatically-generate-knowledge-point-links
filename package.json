{
  "name": "knowledge-nav",
  "version": "0.1.0",
  "description": "Obsidian plugin: generate a knowledge-point-level navigation block at the top of a note.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "esbuild tests/run.ts --bundle --platform=node --format=cjs --outfile=tests/run.js && node tests/run.js",
    "e2e": "esbuild tests/e2e.ts --bundle --platform=node --format=cjs --outfile=tests/e2e.js && node tests/e2e.js"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "toc",
    "navigation",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.18.6",
    "builtin-modules": "5.0.0",
    "esbuild": "0.25.10",
    "obsidian": "1.8.7",
    "typescript": "5.9.3"
  }
}
